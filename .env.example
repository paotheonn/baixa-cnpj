# Identificador publico do compartilhamento WebDAV de dados abertos de CNPJ.
# Na pagina da Receita Federal, abra o link do compartilhamento e copie
# somente o trecho final de index.php/s/<identificador>.
# https://www.gov.br/receitafederal/pt-br/assuntos/orientacao-tributaria/cadastros/consultas/dados-publicos-cnpj
RF_NEXTCLOUD_SHARE_TOKEN=

# Opcional. Vazio usa o endpoint WebDAV publico da Receita Federal.
RF_NEXTCLOUD_WEBDAV_URL=

# Opcional. O frontend Next.js le esta variavel em web/.env.local, nao na raiz.
# NEXT_PUBLIC_RF_CNPJ_API_URL=http://127.0.0.1:8000
